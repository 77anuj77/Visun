# The browser calls same-origin `/api/backend/*`; Next.js rewrites it to FastAPI.
# Leave this blank for local development (http://localhost:8000 is the default)
# and set the deployed API origin for production.
BACKEND_ORIGIN=

# --- Clerk (optional) -------------------------------------------------------
# Leave both keys blank to keep the original credential-free demo mode.
# With a publishable key the landing page opens Clerk sign-in/sign-up, /app is
# protected, and API requests carry a Clerk bearer token.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# The seeded demo stays reachable at /app?demo=1. In a Clerk-mode API, also set
# ALLOW_PUBLIC_DEMO=true in backend/.env so the demo header is accepted.

# --- Contact form delivery (Resend) -----------------------------------------
# Server-only. The browser posts to /api/contact and never sees these values.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=
# While testing with onboarding@resend.dev, this must be the email address on
# the Resend account. After verifying a domain, it can be any inbox you own.
CONTACT_TO_EMAIL=
# Use the Resend test sender until your domain is verified, then change this to
# something like "Visun <contact@your-verified-domain.com>".
CONTACT_FROM_EMAIL="Visun <onboarding@resend.dev>"
