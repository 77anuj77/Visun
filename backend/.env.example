# Visun backend environment.
# Copy to `.env` and fill only what you actually use. Never commit `.env`.
# Every integration stays optional: with the defaults below the API runs fully
# offline in demo auth + simulated provider mode.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
DATABASE_URL=sqlite:///./visun.db
AUTH_MODE=demo
# Allow the seeded demo workspace when AUTH_MODE=clerk. The browser sends
# `X-Visun-Demo: 1` from /app?demo=1. Keep false unless you want public demo
# access on a Clerk-protected deployment.
ALLOW_PUBLIC_DEMO=false
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
PROVIDER_MODE=simulated
ACTION_EXPIRY_MINUTES=30

# Supabase PostgreSQL instead of SQLite:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres

# --- Clerk (required when AUTH_MODE=clerk; demo auth is refused in production)
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_JWT_AUDIENCE=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Supabase (optional; the REST keys are not required for Postgres) -------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Agent / voice ----------------------------------------------------------
# deterministic = grounded tools + templates (default, no credentials)
# gemini        = Gemini text phrasing over the same grounded tool results
AGENT_BACKEND=deterministic
GEMINI_TEXT_MODEL=
# browser = Web Speech + backend transcript fallback; gemini_live = Live API bridge
VOICE_BACKEND=browser
GEMINI_LIVE_MODEL=
GOOGLE_API_KEY=

# --- Google OAuth (Gmail + Calendar) ---------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_REFRESH_TOKEN=

# --- PayPal Sandbox ---------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_PROJECT_MAP={}

# --- Discord ----------------------------------------------------------------
# Optional allowlisted-channel intake. Only channels named during setup are read.
DISCORD_BOT_TOKEN=

# --- App --------------------------------------------------------------------
# Required to store provider credentials from Settings > Integrations. Generate
# with: python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_ENCRYPTION_KEY=
EXTRA_ORIGINS=
