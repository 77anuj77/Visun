# Compose-level variables. This file is read by `docker compose` itself.
# Never put provider secrets here; runtime secrets live in env/*.env.

# Local address. Change only if port 3000 is already in use.
VISUN_PORT=3000

# The browser origin customers use. It must match how they open Visun.
# localhost is fine for a personal machine; use the LAN/domain URL otherwise.
VISUN_APP_ORIGIN=http://localhost:3000

# Clerk publishable key. Public configuration, but still per installation.
# Required at image build time because Next inlines NEXT_PUBLIC_* values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: copy these if your Clerk application uses different routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Optional reverse-proxy port when using `--profile proxy`.
VISUN_PROXY_PORT=8080
