# Frontend runtime configuration for one Visun installation.
# Copy to env/frontend.env. BACKEND_ORIGIN is set by compose.yaml.

# Clerk secret used by the Next.js proxy. Server-only; never NEXT_PUBLIC_*.
CLERK_SECRET_KEY=

# --- Contact / installation requests (Resend) -------------------------------
# Server-only. Contact inquiries are emailed, not stored in a database.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Visun <onboarding@resend.dev>"
