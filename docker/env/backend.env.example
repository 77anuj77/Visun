# Backend runtime configuration for one Visun installation.
# Copy to env/backend.env and fill with the customer's own values.
# Never reuse the developer's keys, database, or encryption key.

# --- Core -------------------------------------------------------------------
# Use "production" only behind HTTPS (for example a trusted Caddy setup).
# ENVIRONMENT=production refuses AUTH_MODE=demo and plain-HTTP origins.
ENVIRONMENT=development
AUTH_MODE=clerk
# Lets visitors open the $0 seeded demo without an account. The demo can only
# read sample records, writes are approval-gated, and provider actions are
# forced to simulated mode regardless of PROVIDER_MODE.
ALLOW_PUBLIC_DEMO=true
PROVIDER_MODE=simulated
LOG_LEVEL=INFO
ACTION_EXPIRY_MINUTES=30

# Generated once for this installation. Do not rotate it after credentials are
# stored without a migration/rewrap procedure.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENCRYPTION_KEY=

# --- Clerk (required for private customer sign-in) --------------------------
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_JWT_AUDIENCE=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- Gemini / voice ---------------------------------------------------------
# Optional. The deterministic agent works without a model key.
GOOGLE_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_LIVE_MODEL=
AGENT_BACKEND=auto
VOICE_BACKEND=auto

# --- Optional integrations --------------------------------------------------
# Keep simulated unless the customer has connected and approved real access.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/backend/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_PROJECT_MAP={}
DISCORD_BOT_TOKEN=
